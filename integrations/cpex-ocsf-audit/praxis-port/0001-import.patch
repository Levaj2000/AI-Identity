+        assert!(sink.as_audit_handler().is_some(), "no hooks -> sink");
+
+        let observer = Arc::new(OcsfAuditEmitter::new(cfg(json!({}))).unwrap());
+        assert!(
+            observer.as_audit_handler().is_none(),
+            "hooks listed -> post-hook observer only, no double emission"
+        );
