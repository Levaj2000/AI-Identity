+            assert_eq!(ev["unmapped"]["cpex.content"]["output_hash"], expected);
+
+            let ev = e.build_decision(None, &subject_ext(), &log, "2026-08-18T12:00:00.000Z");
+            assert_eq!(
+                ev["unmapped"]["cpex.content"]["output_hash"],
+                serde_json::Value::Null
+            );
+        }
