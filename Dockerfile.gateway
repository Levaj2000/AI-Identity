# AI Identity — Proxy Gateway
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps for psycopg2-binary
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

# Install the locked dependency set — hermetically. Wheels come from the CI
# wheelhouse (populated from the pypi-cache Artifact Registry proxy, see
# .github/actions/populate-wheelhouse), --no-index forbids pip from reaching
# any package index, and every wheel is hash-checked against the lock. A PyPI
# deletion or yank therefore cannot fail this build (the 2026-07-24
# liboqs-python yank broke all GKE deploys; see AGENTS.md "Dependency locks").
# Lock layer first: it changes the least, so code edits never bust this layer.
# BuildKit required (default on the GHA runners); the bind mount keeps ~300MB
# of wheels out of the image layers. Building locally? Populate wheelhouse/
# first — command in AGENTS.md — or use docker-compose (root Dockerfile).
COPY gateway/requirements.lock gateway/requirements.lock
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse \
    pip install --no-cache-dir --no-index --find-links=/wheelhouse \
      --require-hashes -r gateway/requirements.lock

# Shared library — after the locks, with --no-deps + --no-build-isolation so
# this editable install can neither resolve anything outside the lock set nor
# reach an index for build deps (its install_requires are all in the lock).
COPY common/ common/
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e common/

# Copy service code
COPY gateway/ gateway/

# Run as non-root user
USER appuser

EXPOSE 8002

CMD ["gunicorn", "gateway.app.main:app", \
     "--workers", "2", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8002", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--forwarded-allow-ips=*"]
