# AI Identity — Mandate Service
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# psycopg2-binary needs libpq; motor is pure Python.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# PQC NOTE: the ML-DSA-87 verify path (liboqs / liboqs-python) is OPT-IN and
# inert in production — verify_signature returns None before importing `oqs`
# unless FORENSIC_MLDSA_PUBLIC_KEY is configured (see mandate/app/signing.py).
# So the native liboqs lib is intentionally NOT built into this image: doing so
# added minutes + a from-source github build to every deploy for a capability
# that's off in prod (and broke the GKE build — bare `gcc` on debian-slim can't
# link; needs build-essential). The liboqs-python *wheel* still installs from
# requirements (harmless loader). To ENABLE PQC verification in a deployment,
# build liboqs here first — corrected recipe (build-essential, not gcc):
#
#   RUN apt-get update \
#       && apt-get install -y --no-install-recommends build-essential libpq-dev \
#            cmake ninja-build git ca-certificates \
#       && git clone --depth 1 --branch 0.15.0 \
#            https://github.com/open-quantum-safe/liboqs /tmp/liboqs \
#       && cmake -S /tmp/liboqs -B /tmp/liboqs/build -GNinja \
#            -DBUILD_SHARED_LIBS=ON -DOQS_BUILD_ONLY_LIB=ON -DCMAKE_BUILD_TYPE=Release \
#       && cmake --build /tmp/liboqs/build --parallel \
#       && cmake --install /tmp/liboqs/build && ldconfig \
#       && rm -rf /tmp/liboqs && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser

# Install the locked dependency set — hermetically. Wheels come from the CI
# wheelhouse (populated from the pypi-cache Artifact Registry proxy, see
# .github/actions/populate-wheelhouse), --no-index forbids pip from reaching
# any package index, and every wheel is hash-checked against the lock. A PyPI
# deletion or yank therefore cannot fail this build — this image is where the
# 2026-07-24 liboqs-python yank broke all GKE deploys (#405).
# Lock layer first: it changes the least, so code edits never bust this layer.
# BuildKit required (default on the GHA runners); the bind mount keeps the
# wheels out of the image layers. Building locally? Populate wheelhouse/
# first — command in AGENTS.md — or use docker-compose (root Dockerfile).
COPY mandate/requirements.lock mandate/requirements.lock
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse \
    pip install --no-cache-dir --no-index --find-links=/wheelhouse \
      --require-hashes -r mandate/requirements.lock

# Shared library — after the locks, with --no-deps + --no-build-isolation so
# this editable install can neither resolve anything outside the lock set nor
# reach an index for build deps (its install_requires are all in the lock).
COPY common/ common/
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e common/

COPY mandate/ mandate/

USER appuser

EXPOSE 8003

CMD ["gunicorn", "mandate.app.main:app", \
     "--workers", "2", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8003", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--forwarded-allow-ips=*"]
