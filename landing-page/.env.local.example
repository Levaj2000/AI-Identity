# Credential-free local development. Start the mock server as described in
# landing-page/README.md before running npm run dev. This never sends mail
# and never searches documents. Do not enable these settings in deployment.
LOCAL_SERVICES=1
RESEND_API_KEY=re_local_only
RESEND_BASE_URL=http://127.0.0.1:4020
MONGODB_URI=mongodb://127.0.0.1:27017

# To use real Vertex AI Search instead, unset LOCAL_SERVICES and set:
# VERTEX_PROJECT_ID=<your Google Cloud project ID>
# VERTEX_LOCATION=global
# VERTEX_ENGINE_ID=forensics-agent

# Auth:
# - Real Vertex local dev: run `gcloud auth application-default login` once,
#   leave the var below unset.
# - Vercel:    set GOOGLE_SERVICE_ACCOUNT_JSON to the contents of a service-account key
#              (or wire up Workload Identity Federation — see scripts/forensics-kb/README.md)
# GOOGLE_SERVICE_ACCOUNT_JSON=
